# Nazar kendi test kontrolleri icin ignore kuralları

# HTML reporter tek buyuk fonksiyon - template oldugu icin normal
rule:long_functions
rule:long_files
rule:complexity
rule:cyclomatic_complexity
rule:maintainability_index
rule:nesting_depth
rule:duplication

# Nazar'in kendi kodundaki import/env false positive'ler
rule:unused
rule:async_errors
rule:undefined_vars
rule:env_var_mismatch
