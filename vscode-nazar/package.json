{
  "name": "nazar-vscode",
  "displayName": "Nazar - Otonom Test Araci",
  "description": "Kod yazarken anlik guvenlik ve kalite taramasi",
  "version": "3.0.0",
  "publisher": "nazar",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Testing",
    "Other"
  ],
  "keywords": [
    "security",
    "linter",
    "testing",
    "code-quality",
    "nazar"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:python",
    "onLanguage:go",
    "onLanguage:rust",
    "onLanguage:dart",
    "onLanguage:swift",
    "onLanguage:kotlin",
    "onLanguage:java"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nazar.scanFile",
        "title": "Nazar: Dosyayi Tara"
      },
      {
        "command": "nazar.scanProject",
        "title": "Nazar: Projeyi Tara"
      },
      {
        "command": "nazar.showGuide",
        "title": "Nazar: Duzeltme Rehberi Goster"
      }
    ],
    "configuration": {
      "title": "Nazar",
      "properties": {
        "nazar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Nazar otomatik taramayi aktif et"
        },
        "nazar.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Dosya kaydedildiginde otomatik tara"
        },
        "nazar.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Python yorumlayici yolu"
        },
        "nazar.severityFilter": {
          "type": "string",
          "default": "warning",
          "enum": ["info", "warning", "high", "critical"],
          "description": "Minimum severity filtresi"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
